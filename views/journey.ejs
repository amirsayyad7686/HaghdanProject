<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= lang === 'fa' ? 'rtl' : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    
    <style>
        body { margin: 0; overflow: hidden; background-color: #020617; font-family: sans-serif; }
        #canvas-container { position: absolute; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1; }
        #ui-layer { position: absolute; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 10; pointer-events: none; display: flex; flex-direction: column; align-items: center; justify-content: space-between; }
        .interactive-btn { pointer-events: auto; }
        
        @keyframes slowBlink {
            0%, 100% { opacity: 0.2; transform: translate(-50%, -50%) scale(0.95); }
            50% { opacity: 1; text-shadow: 0 0 30px rgba(16, 185, 129, 1); transform: translate(-50%, -50%) scale(1.05); }
        }
        .text-glow-blink { animation: slowBlink 3.5s infinite ease-in-out; }
    </style>
</head>
<body>

    <div id="canvas-container"></div>

    <div id="ui-layer" class="py-8 sm:py-12 px-6">
        
        <div class="w-full flex justify-between items-start interactive-btn relative z-20">
            <a href="/" class="text-slate-500 hover:text-white transition-colors flex items-center gap-2 text-xs sm:text-sm uppercase tracking-widest font-bold">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                <span class="hidden sm:inline"><%= __('Return') %></span>
            </a>
            <div id="step-indicator" class="text-emerald-500/80 font-mono text-[10px] sm:text-xs tracking-[0.2em] sm:tracking-[0.3em] uppercase opacity-0 transition-opacity text-right">
                [ STEP 01: THE SEED ]
            </div>
        </div>

        <div id="intro-text" class="absolute top-[12%] sm:top-[15%] left-1/2 -translate-x-1/2 w-full text-center px-4 sm:px-6">
            <h1 id="main-title" class="text-4xl sm:text-5xl md:text-6xl font-black text-white tracking-tight mb-2 sm:mb-4 opacity-0 transform translate-y-8 drop-shadow-2xl">
                <%= __('The Tree of Life') %>
            </h1>
            <p id="sub-title" class="text-emerald-400 text-base sm:text-lg md:text-xl font-medium tracking-wide opacity-0 drop-shadow-md">
                <%= __('Everything begins from within.') %>
            </p>
        </div>

        <div id="step-one-text" class="absolute top-[10%] sm:top-[15%] left-1/2 -translate-x-1/2 w-full max-w-3xl px-4 sm:px-6 text-center opacity-0 pointer-events-none">
            <h2 class="text-2xl sm:text-4xl md:text-5xl font-black text-white mb-2 sm:mb-4 tracking-tight drop-shadow-2xl">
                <%= __('Step 1 Custom Title') %>
            </h2>
            <p class="text-emerald-100 text-sm sm:text-base md:text-xl leading-relaxed drop-shadow-md">
                <%= __('Step 1 Custom Explanation') %>
            </p>
        </div>

        <div id="step-two-text" class="absolute top-[10%] sm:top-[15%] left-1/2 -translate-x-1/2 w-full max-w-3xl px-4 sm:px-6 text-center opacity-0 pointer-events-none">
            <h2 class="text-2xl sm:text-4xl md:text-5xl font-black text-white mb-2 sm:mb-4 tracking-tight drop-shadow-2xl">
                <%= __('Step 2 Custom Title') %>
            </h2>
            <p class="text-emerald-100 text-sm sm:text-base md:text-xl leading-relaxed drop-shadow-md">
                <%= __('Step 2 Custom Explanation') %>
            </p>
        </div>

        <div id="step-three-text" class="absolute top-[10%] sm:top-[15%] left-1/2 -translate-x-1/2 w-full max-w-3xl px-4 sm:px-6 text-center opacity-0 pointer-events-none">
            <h2 class="text-2xl sm:text-4xl md:text-5xl font-black text-white mb-2 sm:mb-4 tracking-tight drop-shadow-2xl">
                <%= __('The Round Table') %>
            </h2>
            <p class="text-emerald-100 text-sm sm:text-base md:text-xl leading-relaxed drop-shadow-md">
                <%= __('By combining diverse resources—capital, skills, and empathy—we forge a syndicate. Every branch connects to create a unified system.') %>
            </p>
        </div>

        <div id="me-text" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-4xl sm:text-5xl md:text-7xl font-black text-white text-glow-blink pointer-events-none opacity-0">
            <%= __('ME') %>
        </div>

        <div class="mt-auto mb-6 sm:mb-10 interactive-btn w-full flex justify-center z-20">
            <button id="btn-start" class="text-white border border-slate-700 bg-slate-900/50 backdrop-blur-md hover:bg-white hover:text-black hover:border-white rounded-full px-8 sm:px-12 py-3 sm:py-4 font-bold tracking-widest uppercase transition-all duration-500 text-xs sm:text-sm shadow-[0_0_30px_rgba(255,255,255,0.1)] hover:shadow-[0_0_40px_rgba(255,255,255,0.4)]">
                <%= __('Begin Journey') %>
            </button>
            
            <button id="btn-next" class="hidden text-emerald-950 bg-emerald-400 hover:bg-emerald-300 rounded-full px-8 sm:px-12 py-3 sm:py-4 font-bold tracking-widest uppercase transition-all duration-300 text-xs sm:text-sm shadow-[0_0_30px_rgba(52,211,153,0.3)] hover:shadow-[0_0_50px_rgba(52,211,153,0.6)]">
                <span id="btn-next-text"><%= __('Next Phase') %></span> →
            </button>
        </div>
    </div>

    <script>
        // --- 1. SETUP THREE.JS SCENE ---
        const container = document.getElementById('canvas-container');
        const scene = new THREE.Scene();
        scene.fog = new THREE.FogExp2(0x020617, 0.015); 

        const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 25;
        camera.position.y = 5;
        
        const cameraTarget = new THREE.Vector3(0, 0, 0);

        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        container.appendChild(renderer.domElement);

        // --- 2. LIGHTING ---
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);
        scene.add(ambientLight);
        
        const directionalLight = new THREE.DirectionalLight(0xffffff, 1.5);
        directionalLight.position.set(15, 30, 15);
        scene.add(directionalLight);
        
        const backLight = new THREE.DirectionalLight(0x34d399, 1);
        backLight.position.set(-15, 10, -15);
        scene.add(backLight);

        const pointLight = new THREE.PointLight(0x10b981, 0, 50);
        pointLight.position.set(0, 0, 0);
        scene.add(pointLight);

        // --- 3. THE "ME" CORE (Step 1) ---
        const coreGeometry = new THREE.SphereGeometry(2, 32, 32);
        const coreMaterial = new THREE.MeshStandardMaterial({ color: 0x10b981, emissive: 0x10b981, emissiveIntensity: 0, wireframe: true, transparent: true, opacity: 0 });
        const core = new THREE.Mesh(coreGeometry, coreMaterial);
        scene.add(core);

        const branchesGroup = new THREE.Group();
        scene.add(branchesGroup);

        function createBranch(startX, startY, endX, endY) {
            const material = new THREE.LineBasicMaterial({ color: 0x34d399, transparent: true, opacity: 0, linewidth: 2 });
            const geometry = new THREE.BufferGeometry().setFromPoints([
                new THREE.Vector3(startX, startY, 0), new THREE.Vector3(startX, startY, 0)
            ]);
            const line = new THREE.Line(geometry, material);
            branchesGroup.add(line);
            return { mesh: line, targetEnd: new THREE.Vector3(endX, endY, (Math.random() - 0.5) * 5) };
        }
        const flatBranches = [
            createBranch(0, 0, 10, 10), createBranch(0, 0, -10, 10),
            createBranch(0, 0, 12, -5), createBranch(0, 0, -12, -5)
        ];

        // --- 4. THE ORGANIC TREE & LEAVES (Step 2) ---
        const treeGroup = new THREE.Group();
        treeGroup.position.y = -6; 
        scene.add(treeGroup);
        const treeMeshes = [];
        const leafMeshes = []; 

        const treeMaterial = new THREE.MeshStandardMaterial({ color: 0x065f46, roughness: 0.9, metalness: 0.1, transparent: true, opacity: 0 });
        const leafMaterial = new THREE.MeshStandardMaterial({ color: 0x10b981, emissive: 0x059669, emissiveIntensity: 0.2, roughness: 0.4, transparent: true, opacity: 0 });
        
        // Changed to sharp, small geometric shards instead of giant bubbles
        const leafGeometry = new THREE.IcosahedronGeometry(1.0, 0);

        function buildSolidTree(parent, startPoint, length, thickness, angleZ, angleX, depth) {
            if (depth === 0) {
                const leaf = new THREE.Mesh(leafGeometry, leafMaterial);
                leaf.position.copy(startPoint);
                // Randomize leaf rotations so they look organic
                leaf.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, Math.random() * Math.PI);
                const scale = 0.5 + Math.random() * 0.7; // Much smaller radius
                leaf.scale.set(scale, scale, scale);
                parent.add(leaf);
                leafMeshes.push(leaf);
                return;
            }
            
            const organicAngleZ = angleZ + (Math.random() - 0.5) * 0.3;
            const organicAngleX = angleX + (Math.random() - 0.5) * 0.3;

            const endPoint = new THREE.Vector3(
                startPoint.x + Math.sin(organicAngleZ) * length * Math.cos(organicAngleX),
                startPoint.y + Math.cos(organicAngleZ) * length,
                startPoint.z + Math.sin(organicAngleZ) * length * Math.sin(organicAngleX)
            );

            const distance = startPoint.distanceTo(endPoint);
            const direction = new THREE.Vector3().subVectors(endPoint, startPoint).normalize();

            const branchGeo = new THREE.CylinderGeometry(thickness * 0.65, thickness, distance, 7);
            branchGeo.translate(0, distance / 2, 0);

            const branchMesh = new THREE.Mesh(branchGeo, treeMaterial);
            branchMesh.position.copy(startPoint);
            
            const quaternion = new THREE.Quaternion();
            quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), direction);
            branchMesh.setRotationFromQuaternion(quaternion);

            parent.add(branchMesh);
            treeMeshes.push(branchMesh);

            buildSolidTree(parent, endPoint, length * 0.8, thickness * 0.65, organicAngleZ + 0.7, organicAngleX + 1.5, depth - 1);
            buildSolidTree(parent, endPoint, length * 0.8, thickness * 0.65, organicAngleZ - 0.7, organicAngleX - 1.5, depth - 1);
            if (depth > 1) {
                buildSolidTree(parent, endPoint, length * 0.7, thickness * 0.6, organicAngleZ + (Math.random() * 0.5), organicAngleX + 3.0, depth - 1);
            }
        }
        buildSolidTree(treeGroup, new THREE.Vector3(0, 0, 0), 7, 1.5, 0, 0, 5);
        treeGroup.scale.set(0.01, 0.01, 0.01); 

        // --- 5. THE ROUND TABLE & REALISTIC PEOPLE (Step 3) ---
        const tableGroup = new THREE.Group();
        tableGroup.position.y = -2; 
        scene.add(tableGroup);

        // Main Table Base
        const tableGeo = new THREE.CylinderGeometry(8, 8, 0.5, 64);
        const tableMat = new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.1, metalness: 0.7, transparent: true, opacity: 0 });
        const table = new THREE.Mesh(tableGeo, tableMat);
        tableGroup.add(table);

        const ringGeo = new THREE.RingGeometry(4.5, 5, 64);
        const ringMat = new THREE.MeshBasicMaterial({ color: 0x10b981, side: THREE.DoubleSide, transparent: true, opacity: 0 });
        const ring = new THREE.Mesh(ringGeo, ringMat);
        ring.rotation.x = Math.PI / 2;
        ring.position.y = 0.26; 
        tableGroup.add(ring);

        // Function to create a realistic person silhouette
        function createPerson(colorHex) {
            const group = new THREE.Group();
            
            // Shoulders / Body
            const bodyGeo = new THREE.CylinderGeometry(1, 2, 3, 16);
            const bodyMat = new THREE.MeshStandardMaterial({ color: colorHex, roughness: 0.5, metalness: 0.2, transparent: true, opacity: 0 });
            const body = new THREE.Mesh(bodyGeo, bodyMat);
            body.position.y = 1.5;
            group.add(body);

            // Head
            const headGeo = new THREE.SphereGeometry(1.2, 16, 16);
            const headMat = new THREE.MeshStandardMaterial({ color: colorHex, roughness: 0.4, metalness: 0.1, transparent: true, opacity: 0 });
            const head = new THREE.Mesh(headGeo, headMat);
            head.position.y = 4;
            group.add(head);

            return { group, materials: [bodyMat, headMat] };
        }

        const nodeColors = [0x3b82f6, 0x10b981, 0xf59e0b, 0xa855f7]; // Blue, Emerald, Amber, Purple
        const peopleMeshes = [];
        
        for(let i=0; i<4; i++) {
            const angle = (i * Math.PI) / 2;
            const personData = createPerson(nodeColors[i]);
            const personGroup = personData.group;
            
            // Place them around the table
            personGroup.position.set(Math.cos(angle) * 11, 0, Math.sin(angle) * 11);
            
            // Make them face the center of the table
            personGroup.lookAt(0, 1.5, 0);
            
            tableGroup.add(personGroup);
            peopleMeshes.push(personData);
        }
        tableGroup.scale.set(0, 0, 0); 

        // --- 6. ANIMATION LOOP ---
        const clock = new THREE.Clock();
        function animate() {
            requestAnimationFrame(animate);
            const time = clock.getElapsedTime();
            
            camera.lookAt(cameraTarget);

            core.rotation.y = time * 0.2;
            core.rotation.x = time * 0.1;
            branchesGroup.rotation.z = Math.sin(time * 0.5) * 0.05;
            treeGroup.rotation.y = time * 0.05; 
            tableGroup.rotation.y = time * -0.05; 

            renderer.render(scene, camera);
        }
        animate();

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        // --- 7. CINEMATIC TIMELINES & STEP MANAGER ---
        let currentStep = 0;
        
        const btnStart = document.getElementById('btn-start');
        const btnNext = document.getElementById('btn-next');
        const btnNextText = document.getElementById('btn-next-text');
        
        const introText = document.getElementById('intro-text');
        const stepOneText = document.getElementById('step-one-text');
        const stepTwoText = document.getElementById('step-two-text');
        const stepThreeText = document.getElementById('step-three-text');
        
        const meText = document.getElementById('me-text');
        const stepIndicator = document.getElementById('step-indicator');

        gsap.to(document.getElementById('main-title'), { opacity: 1, y: 0, duration: 2, ease: "power3.out", delay: 0.5 });
        gsap.to(document.getElementById('sub-title'), { opacity: 1, duration: 2, ease: "power2.inOut", delay: 1.5 });

        btnStart.addEventListener('click', () => {
            gsap.to([btnStart, introText], { opacity: 0, duration: 1, onComplete: () => {
                btnStart.style.display = 'none';
                introText.style.display = 'none';
                gsap.to(stepIndicator, { opacity: 1, duration: 1 });
                playStepOne();
            }});
        });

        btnNext.addEventListener('click', () => {
            if (currentStep === 1) {
                playStepTwo();
            } else if (currentStep === 2) {
                playStepThree();
            } else if (currentStep === 3) {
                window.location.href = '/cooperate';
            }
        });

        function playStepOne() {
            currentStep = 1;
            const tl = gsap.timeline();

            const isMobile = window.innerWidth < 768;
            const targetZ = isMobile ? 30 : 20;

            tl.to(camera.position, { z: targetZ, y: 5, duration: 4, ease: "power2.inOut" }, 0);
            tl.to(cameraTarget, { y: 0, duration: 4, ease: "power2.inOut" }, 0); 
            
            tl.to(coreMaterial, { opacity: 0.8, emissiveIntensity: 1, duration: 3 }, 0);
            tl.to(pointLight, { intensity: 2, duration: 3 }, 0);
            tl.to(meText, { opacity: 1, duration: 2 }, 1);
            tl.to(stepOneText, { opacity: 1, y: 10, duration: 2, ease: "power2.out" }, 1);

            flatBranches.forEach((branch, index) => {
                tl.to(branch.mesh.material, { opacity: 0.4, duration: 1 }, 2 + (index * 0.2));
                tl.to(branch.mesh.geometry.attributes.position.array, {
                    endArray: [0, 0, 0, branch.targetEnd.x, branch.targetEnd.y, branch.targetEnd.z],
                    3: branch.targetEnd.x, 4: branch.targetEnd.y, 5: branch.targetEnd.z,
                    duration: 3, ease: "power2.out",
                    onUpdate: function() { branch.mesh.geometry.attributes.position.needsUpdate = true; }
                }, 2 + (index * 0.2));
            });

            tl.call(() => {
                btnNext.style.display = 'block';
                gsap.fromTo(btnNext, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 1 });
            }, [], "+=0.5");
        }

        function playStepTwo() {
            currentStep = 2;
            const tl = gsap.timeline();

            tl.to(btnNext, { opacity: 0, duration: 0.5, onComplete: () => btnNext.style.pointerEvents = 'none' }, 0);
            tl.to(meText, { opacity: 0, duration: 1 }, 0);
            tl.to(stepOneText, { opacity: 0, y: -10, duration: 1 }, 0);
            
            tl.to(stepIndicator, { opacity: 0, duration: 0.5, onComplete: () => {
                stepIndicator.innerText = "[ STEP 02: THE GROWTH ]";
            }}, 0);
            tl.to(stepIndicator, { opacity: 1, duration: 0.5 }, 1);

            // ADJUSTED: Smaller tree size and pushed camera further back
            const isMobile = window.innerWidth < 768;
            const targetZ = isMobile ? 60 : 45;  
            const targetY = isMobile ? 22 : 18;
            const treeScale = isMobile ? 1.2 : 1.5;

            tl.to(camera.position, { y: targetY, z: targetZ, duration: 4, ease: "power2.inOut" }, 0);
            tl.to(cameraTarget, { y: 8, duration: 4, ease: "power2.inOut" }, 0); 

            tl.to(branchesGroup.scale, { x: 0, y: 0, z: 0, duration: 2, ease: "power2.in" }, 0);
            tl.to(core.scale, { x: 0.2, y: 0.2, z: 0.2, duration: 2 }, 0);

            tl.to(treeGroup.scale, { x: treeScale, y: treeScale, z: treeScale, duration: 5, ease: "back.out(1.2)" }, 1);
            
            treeMeshes.forEach((line, i) => { tl.to(line.material, { opacity: 1, duration: 2 }, 1 + (i * 0.01)); });
            
            leafMeshes.forEach((leaf, i) => {
                leaf.scale.set(0.1, 0.1, 0.1);
                const randomDelay = 3 + (Math.random() * 2);
                tl.to(leaf.material, { opacity: 0.8, duration: 2 }, randomDelay);
                tl.to(leaf.scale, { x: 1, y: 1, z: 1, duration: 3, ease: "elastic.out(1, 0.3)" }, randomDelay);
            });

            tl.to(stepTwoText, { opacity: 1, y: 10, duration: 2, ease: "power2.out" }, 3);
            tl.to(btnNext, { opacity: 1, duration: 1, onComplete: () => btnNext.style.pointerEvents = 'auto' }, 6.5);
        }

        function playStepThree() {
            currentStep = 3;
            const tl = gsap.timeline();

            tl.to(btnNext, { opacity: 0, duration: 0.5, onComplete: () => btnNext.style.pointerEvents = 'none' }, 0);
            tl.to(stepTwoText, { opacity: 0, y: -10, duration: 1 }, 0);
            
            tl.to(stepIndicator, { opacity: 0, duration: 0.5, onComplete: () => {
                stepIndicator.innerText = "[ STEP 03: THE SYNERGY ]";
            }}, 0);
            tl.to(stepIndicator, { opacity: 1, duration: 0.5 }, 1);

            // ADJUSTED: Dive into the shorter tree
            tl.to(camera.position, { y: 12, z: 2, duration: 3, ease: "power2.in" }, 0);
            
            tl.to(treeGroup.scale, { x: 0, y: 0, z: 0, duration: 0.2 }, 3);
            tl.to(core.scale, { x: 0, y: 0, z: 0, duration: 0.2 }, 3);
            
            tl.to(tableGroup.scale, { x: 1, y: 1, z: 1, duration: 4, ease: "back.out(1.2)" }, 3.1);
            tl.to(tableMat, { opacity: 1, duration: 2 }, 3.1);
            tl.to(ringMat, { opacity: 0.8, duration: 2 }, 3.1);
            
            // Fade in all people's heads and bodies
            peopleMeshes.forEach(person => {
                person.materials.forEach(mat => {
                    tl.to(mat, { opacity: 1, duration: 2 }, 3.1);
                });
            });

            const isMobile = window.innerWidth < 768;
            const targetZ = isMobile ? 35 : 25;
            const targetY = isMobile ? 25 : 18;

            tl.to(camera.position, { y: targetY, z: targetZ, duration: 4, ease: "power2.out" }, 3.1);
            tl.to(cameraTarget, { y: -2, duration: 4, ease: "power2.out" }, 3.1);

            tl.to(stepThreeText, { opacity: 1, y: 10, duration: 2, ease: "power2.out" }, 4.5);

            tl.call(() => {
                btnNextText.innerText = "<%= __('Enter the Matrix') %>";
                gsap.fromTo(btnNext, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 1, onComplete: () => btnNext.style.pointerEvents = 'auto' });
            }, [], "+=1.5");
        }

    </script>
</body>
</html>
<%- include('partials/header') %>

<style>
    @keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-10px) rotate(1deg); }
    }
    @keyframes pulse-subtle {
        0%, 100% { opacity: 0.2; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(1.05); }
    }
    .animate-float { animation: float 6s ease-in-out infinite; }
    .animate-pulse-subtle { animation: pulse-subtle 4s ease-in-out infinite; }
    
    /* افکت پویای کارت‌های میزگرد */
    .perspective-card {
        perspective: 1000px;
    }
    .inner-card-hover:hover {
        transform: translateY(-4px) scale(1.02);
        box-shadow: 0 20px 25px -5px rgba(16, 185, 129, 0.1), 0 10px 10px -5px rgba(16, 185, 129, 0.04);
    }
</style>

<div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    
    <div class="text-center mb-16 relative">
        <div class="absolute inset-0 flex items-center justify-center -translate-y-8 pointer-events-none">
            <div class="w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl animate-pulse-subtle"></div>
        </div>
        
        <span class="inline-flex items-center px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 mb-4 backdrop-blur-sm">
            <%= __('Ecosystem Transformation') %>
        </span>
        <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight leading-none mb-6">
            <%= __('Group Therapy') %>
        </h1>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed font-medium">
            <%= __('A safe space for healing, synergy, and inner peace.') %>
        </p>
    </div>

    <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-emerald-950 rounded-[40px] p-8 sm:p-16 mb-20 shadow-2xl relative overflow-hidden text-white animate-float">
        <div class="absolute top-0 right-0 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
        
        <div class="relative z-10 max-w-4xl mx-auto text-center space-y-6">
            <h2 class="text-2xl sm:text-3xl font-black text-emerald-400 tracking-tight">
                <%= __('Revisiting and Deeper Analysis') %>
            </h2>
            <p class="text-lg sm:text-xl leading-relaxed text-slate-200 font-medium">
                <%= __('therapy_intro') %>
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-20">
        
        <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm transition-all duration-300 inner-card-hover flex flex-col justify-between">
            <div>
                <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center mb-6">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                </div>
                <h3 class="text-2xl font-black text-slate-900 mb-4"><%= __('Structuring the Idea') %></h3>
                <p class="text-slate-600 text-sm leading-relaxed"><%= __('Structuring the Idea Desc') %></p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-100 text-xs font-bold text-blue-600 uppercase tracking-wider"><%= __('Social Enterprises Approach') %></div>
        </div>

        <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm transition-all duration-300 inner-card-hover flex flex-col justify-between lg:row-span-2">
            <div>
                <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center mb-6">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                </div>
                <h3 class="text-2xl font-black text-slate-900 mb-4"><%= __('Building the Foundation for Participation') %></h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-6"><%= __('Building the Foundation for Participation Desc') %></p>
                
                <div class="space-y-3">
                    <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200/60 hover:bg-emerald-50/30 transition-colors">
                        <h4 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                            <%= __('Facilitators') %>
                        </h4>
                        <p class="text-xs text-slate-500 mt-1 leading-relaxed"><%= __('Facilitators Desc') %></p>
                    </div>
                    <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200/60 hover:bg-emerald-50/30 transition-colors">
                        <h4 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                            <%= __('Economic Agents') %>
                        </h4>
                        <p class="text-xs text-slate-500 mt-1 leading-relaxed"><%= __('Economic Agents Desc') %></p>
                    </div>
                    <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200/60 hover:bg-emerald-50/30 transition-colors">
                        <h4 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                            <%= __('Target Community') %>
                        </h4>
                        <p class="text-xs text-slate-500 mt-1 leading-relaxed"><%= __('Target Community Desc') %></p>
                    </div>
                </div>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-100 text-xs font-bold text-emerald-600 uppercase tracking-wider"><%= __('Dynamic Roundtable Roles') %></div>
        </div>

        <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm transition-all duration-300 inner-card-hover flex flex-col justify-between">
            <div>
                <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center mb-6">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                </div>
                <h3 class="text-2xl font-black text-slate-900 mb-4"><%= __('Principles of Ethical Conduct') %></h3>
                <p class="text-slate-600 text-sm leading-relaxed"><%= __('Principles of Ethical Conduct Desc') %></p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-100 text-xs font-bold text-amber-600 uppercase tracking-wider"><%= __('Absolute Transparency Rule') %></div>
        </div>

        <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm transition-all duration-300 inner-card-hover flex flex-col justify-between lg:col-span-2">
            <div>
                <div class="w-12 h-12 bg-purple-50 text-purple-600 rounded-xl flex items-center justify-center mb-6">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                </div>
                <h3 class="text-2xl font-black text-slate-900 mb-4"><%= __('Clarifying the Vision') %></h3>
                <p class="text-slate-600 text-sm leading-relaxed"><%= __('Clarifying the Vision Desc') %></p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-100 text-xs font-bold text-purple-600 uppercase tracking-wider"><%= __('Collective Transformation Goals') %></div>
        </div>

    </div>

 <div class="text-center mb-10 relative z-10">
        <h2 class="text-3xl font-black text-slate-900 tracking-tight"><%= __('Find Your Role at the Round Table') %></h2>
        <p class="text-slate-500 mt-2 text-lg max-w-2xl mx-auto"><%= __('Click on the participant whose mindset and resources best align with yours to discover your ethical mandate.') %></p>
    </div>

    <div class="bg-white rounded-[40px] shadow-2xl border border-slate-200 p-8 sm:p-12 mb-20 relative">
        
        <div class="absolute inset-0 overflow-hidden rounded-[40px] pointer-events-none">
            <div class="absolute top-0 right-0 w-64 h-64 bg-blue-500/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
            <div class="absolute bottom-0 left-0 w-64 h-64 bg-emerald-500/5 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>
        </div>

        <div class="flex flex-col lg:flex-row gap-12 items-center relative z-10">
            
  <div class="w-full lg:w-1/2 relative aspect-square max-w-[300px] sm:max-w-md mx-auto flex items-center justify-center my-8 sm:my-12">
                
                <div class="absolute w-48 h-48 sm:w-72 sm:h-72 rounded-full bg-[radial-gradient(ellipse_at_center,_#f8fafc,_#e2e8f0)] border-[12px] sm:border-[16px] border-slate-300 shadow-[inset_0_10px_25px_rgba(0,0,0,0.15),_0_20px_40px_rgba(0,0,0,0.1)] flex items-center justify-center">
                    <div class="absolute inset-2 sm:inset-4 rounded-full border border-slate-300/60 shadow-[inset_0_2px_4px_rgba(0,0,0,0.05)]"></div>
                    <div class="w-16 h-16 sm:w-24 sm:h-24 rounded-full bg-white shadow-md border border-slate-100 flex items-center justify-center z-10">
                        <div class="text-center">
                            <span class="block text-emerald-600 font-black text-sm sm:text-xl leading-none"><%= __('Matrix') %></span>
                        </div>
                    </div>
                </div>

                <button onclick="selectRole('provider')" class="participant-btn group absolute top-0 left-1/2 -translate-x-1/2 -translate-y-4 sm:-translate-y-6 focus:outline-none transition-transform hover:scale-110 hover:z-50 cursor-pointer">
                    <div class="relative flex flex-col items-center">
                        <div id="avatar-provider" class="w-16 h-16 sm:w-24 sm:h-24 rounded-full bg-white border-4 border-blue-200 flex items-end justify-center shadow-lg transition-colors overflow-hidden pt-2 sm:pt-3">
                            <svg class="w-10 h-10 sm:w-16 sm:h-16 text-blue-200" viewBox="0 0 64 64" fill="currentColor">
                                <circle cx="32" cy="20" r="14" fill="#bfdbfe"/>
                                <path d="M32 38 c -16 0 -24 12 -24 26 h 48 c 0 -14 -8 -26 -24 -26 z" fill="#60a5fa"/>
                                <path d="M28 38 l 4 12 l 4 -12 z" fill="#1d4ed8"/>
                            </svg>
                        </div>
                        <div class="hidden lg:block absolute top-[105%] left-1/2 -translate-x-1/2 mt-3 w-52 opacity-0 group-hover:opacity-100 transition-all pointer-events-none z-30 scale-95 group-hover:scale-100 origin-top">
                            <div class="bg-slate-900 text-white text-xs p-4 rounded-2xl shadow-2xl relative border border-slate-700 text-center">
                                <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-4 h-4 bg-slate-900 border-t border-l border-slate-700 transform rotate-45"></div>
                                "<%= __('I have unused facilities and capital. I want to back a solid team transparently.') %>"
                            </div>
                        </div>
                    </div>
                </button>

                <button onclick="selectRole('builder')" class="participant-btn group absolute right-0 top-1/2 translate-x-4 sm:translate-x-6 -translate-y-1/2 focus:outline-none transition-transform hover:scale-110 hover:z-50 cursor-pointer">
                    <div class="relative flex flex-row items-center">
                        <div class="hidden lg:block absolute right-[105%] top-1/2 -translate-y-1/2 mr-3 rtl:mr-0 rtl:ml-3 rtl:right-auto rtl:left-[105%] w-52 opacity-0 group-hover:opacity-100 transition-all pointer-events-none z-30 scale-95 group-hover:scale-100 origin-right rtl:origin-left">
                            <div class="bg-slate-900 text-white text-xs p-4 rounded-2xl shadow-2xl relative border border-slate-700 text-center">
                                <div class="absolute top-1/2 -right-2 -translate-y-1/2 w-4 h-4 bg-slate-900 border-t border-r border-slate-700 transform rotate-45 rtl:-left-2 rtl:right-auto rtl:-rotate-[135deg]"></div>
                                "<%= __('I have a technical solution for clean energy, but I need access to manufacturing tools.') %>"
                            </div>
                        </div>
                        <div id="avatar-builder" class="w-16 h-16 sm:w-24 sm:h-24 rounded-full bg-white border-4 border-emerald-200 flex items-end justify-center shadow-lg transition-colors overflow-hidden pt-2 sm:pt-3">
                            <svg class="w-10 h-10 sm:w-16 sm:h-16 text-emerald-200" viewBox="0 0 64 64" fill="currentColor">
                                <path d="M20 22 a 12 12 0 0 1 24 0 h 2 a 2 2 0 0 1 0 4 h -28 a 2 2 0 0 1 0 -4 h 2 z" fill="#059669"/>
                                <circle cx="32" cy="24" r="10" fill="#a7f3d0"/>
                                <path d="M32 38 c -16 0 -24 12 -24 26 h 48 c 0 -14 -8 -26 -24 -26 z" fill="#34d399"/>
                            </svg>
                        </div>
                    </div>
                </button>

                <button onclick="selectRole('agent')" class="participant-btn group absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-4 sm:translate-y-6 focus:outline-none transition-transform hover:scale-110 hover:z-50 cursor-pointer">
                    <div class="relative flex flex-col items-center">
                        <div class="hidden lg:block absolute bottom-[105%] left-1/2 -translate-x-1/2 mb-3 w-52 opacity-0 group-hover:opacity-100 transition-all pointer-events-none z-30 scale-95 group-hover:scale-100 origin-bottom">
                            <div class="bg-slate-900 text-white text-xs p-4 rounded-2xl shadow-2xl relative border border-slate-700 text-center">
                                <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-4 h-4 bg-slate-900 border-b border-r border-slate-700 transform rotate-45"></div>
                                "<%= __('I know how to turn raw ideas into profitable, sustainable business models.') %>"
                            </div>
                        </div>
                        <div id="avatar-agent" class="w-16 h-16 sm:w-24 sm:h-24 rounded-full bg-white border-4 border-amber-200 flex items-end justify-center shadow-lg transition-colors overflow-hidden pt-2 sm:pt-3">
                            <svg class="w-10 h-10 sm:w-16 sm:h-16 text-amber-200" viewBox="0 0 64 64" fill="currentColor">
                                <circle cx="32" cy="20" r="14" fill="#fde68a"/>
                                <path d="M32 38 c -16 0 -24 12 -24 26 h 16 l 8 -16 l 8 16 h 16 c 0 -14 -8 -26 -24 -26 z" fill="#f59e0b"/>
                                <path d="M24 38 l 8 16 l 8 -16 z" fill="#fffbeb"/>
                            </svg>
                        </div>
                    </div>
                </button>

                <button onclick="selectRole('facilitator')" class="participant-btn group absolute left-0 top-1/2 -translate-x-4 sm:-translate-x-6 -translate-y-1/2 focus:outline-none transition-transform hover:scale-110 hover:z-50 cursor-pointer">
                    <div class="relative flex flex-row items-center">
                        <div id="avatar-facilitator" class="w-16 h-16 sm:w-24 sm:h-24 rounded-full bg-white border-4 border-purple-200 flex items-end justify-center shadow-lg transition-colors overflow-hidden pt-2 sm:pt-3">
                            <svg class="w-10 h-10 sm:w-16 sm:h-16 text-purple-200" viewBox="0 0 64 64" fill="currentColor">
                                <circle cx="32" cy="20" r="14" fill="#e9d5ff"/>
                                <path d="M32 38 c -16 0 -24 12 -24 26 h 48 c 0 -14 -8 -26 -24 -26 z" fill="#a855f7"/>
                                <path d="M22 38 q 10 12 20 0 q -5 18 -10 18 q -5 0 -10 -18 z" fill="#7e22ce"/>
                            </svg>
                        </div>
                        <div class="hidden lg:block absolute left-[105%] top-1/2 -translate-y-1/2 ml-3 rtl:ml-0 rtl:mr-3 rtl:left-auto rtl:right-[105%] w-52 opacity-0 group-hover:opacity-100 transition-all pointer-events-none z-30 scale-95 group-hover:scale-100 origin-left rtl:origin-right">
                            <div class="bg-slate-900 text-white text-xs p-4 rounded-2xl shadow-2xl relative border border-slate-700 text-center">
                                <div class="absolute top-1/2 -left-2 -translate-y-1/2 w-4 h-4 bg-slate-900 border-b border-l border-slate-700 transform rotate-45 rtl:-right-2 rtl:left-auto rtl:-rotate-[135deg]"></div>
                                "<%= __('My focus is on human connection, resolving conflicts, and maintaining trust.') %>"
                            </div>
                        </div>
                    </div>
                </button>

            </div>

            <div class="w-full lg:w-1/2 mt-8 lg:mt-0">
                <div id="role-result-card" class="bg-slate-900 rounded-[32px] p-8 sm:p-10 text-white shadow-2xl relative overflow-hidden min-h-[350px] flex flex-col justify-center transition-all duration-500">
                    
                    <div id="card-glow" class="absolute top-0 right-0 w-64 h-64 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 transition-colors duration-500 bg-slate-800"></div>
                    
                    <div class="relative z-10">
                        
                        <div id="default-message" class="text-center">
                            <div class="w-16 h-16 mx-auto bg-slate-800 rounded-full flex items-center justify-center mb-6 animate-pulse">
                                <svg class="w-8 h-8 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path></svg>
                            </div>
                            <p class="text-slate-400 font-medium text-lg"><%= __('Select a participant from the table to reveal their ethical framework.') %></p>
                        </div>

                        <div id="active-content" class="hidden opacity-0 transition-opacity duration-300">
                            <div class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest bg-white/10 text-white border border-white/20 mb-6 backdrop-blur-sm">
                                <%= __('Your Discovered Role') %>
                            </div>
                            
                            <h3 id="role-title" class="text-3xl sm:text-4xl font-black text-white mb-4">
                                </h3>
                            
                            <div class="h-px w-full bg-slate-700 my-6"></div>
                            
                            <h4 class="text-slate-400 font-bold text-xs uppercase tracking-wider mb-3"><%= __('Your Ethical Framework') %></h4>
                            <p id="role-ethics" class="text-slate-200 leading-relaxed text-lg font-medium">
                                </p>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>

<script>
    const roleData = {
        'provider': {
            title: "<%= __('The Asset Provider') %>",
            ethics: "<%= __('You hold the resources. Your ethical mandate is radical transparency. By shifting from absolute ownership to stewardship, you deploy your assets fairly, ensuring win-win growth for creators without suffocating them.') %>",
            glowColor: "bg-blue-500/20",
            borderActive: "border-blue-500"
        },
        'builder': {
            title: "<%= __('The Builder (Target Community)') %>",
            ethics: "<%= __('You are the creator. Your ethical mandate is integrity in execution. You receive backing based on trust, and your duty is to build true solutions for real needs, eventually giving back to the next generation of builders.') %>",
            glowColor: "bg-emerald-500/20",
            borderActive: "border-emerald-500"
        },
        'agent': {
            title: "<%= __('The Economic Agent') %>",
            ethics: "<%= __('You are the engine of progress. Your ethical mandate is to replace pure extraction with creation. You leverage your management and technical skills to turn raw ideas and assets into sustainable, socially beneficial realities.') %>",
            glowColor: "bg-amber-500/20",
            borderActive: "border-amber-500"
        },
        'facilitator': {
            title: "<%= __('The Facilitator (Host)') %>",
            ethics: "<%= __('Your role is the glue of the ecosystem. Your ethical mandate is to maintain harmony, prevent exploitation, and ensure that all technical and financial negotiations remain transparent and human-centric.') %>",
            glowColor: "bg-purple-500/20",
            borderActive: "border-purple-500"
        }
    };

    function selectRole(selectedRoleId) {
        const defaultMsg = document.getElementById('default-message');
        const activeContent = document.getElementById('active-content');
        const titleEl = document.getElementById('role-title');
        const ethicsEl = document.getElementById('role-ethics');
        const cardGlow = document.getElementById('card-glow');
        
        const data = roleData[selectedRoleId];

        // Reset avatars
        const allAvatars = ['provider', 'builder', 'agent', 'facilitator'];
        allAvatars.forEach(id => {
            const avatarEl = document.getElementById(`avatar-${id}`);
            avatarEl.classList.remove('ring-4', 'ring-offset-4', 'scale-110');
            // Reset borders
            if(id === 'provider') avatarEl.className = avatarEl.className.replace(/border-\w+-500/, 'border-blue-200');
            if(id === 'builder') avatarEl.className = avatarEl.className.replace(/border-\w+-500/, 'border-emerald-200');
            if(id === 'agent') avatarEl.className = avatarEl.className.replace(/border-\w+-500/, 'border-amber-200');
            if(id === 'facilitator') avatarEl.className = avatarEl.className.replace(/border-\w+-500/, 'border-purple-200');
        });

        // Highlight selected
        const selectedAvatar = document.getElementById(`avatar-${selectedRoleId}`);
        selectedAvatar.classList.add('ring-4', 'ring-offset-4', 'scale-110', data.borderActive);

        // Update Card
        activeContent.style.opacity = '0';
        
        setTimeout(() => {
            defaultMsg.style.display = 'none';
            activeContent.classList.remove('hidden');
            
            titleEl.innerHTML = data.title;
            ethicsEl.innerHTML = data.ethics;
            
            cardGlow.className = `absolute top-0 right-0 w-64 h-64 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 transition-colors duration-500 ${data.glowColor}`;
            
            activeContent.style.opacity = '1';
        }, 200);
    }
</script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        // The exact mathematical length of a 90-degree arc on a radius of 50
        const QUADRANT_LENGTH = 78.5398;

        const arcs = {
            top: document.getElementById('arc-top'),
            right: document.getElementById('arc-right'),
            bottom: document.getElementById('arc-bottom'),
            left: document.getElementById('arc-left')
        };
        const core = document.getElementById('core-glow');

        const sliders = {
            top: document.getElementById('slider-emotional'),
            right: document.getElementById('slider-social'),
            bottom: document.getElementById('slider-economic'),
            left: document.getElementById('slider-spiritual')
        };

        const displays = {
            top: document.getElementById('val-emotional'),
            right: document.getElementById('val-social'),
            bottom: document.getElementById('val-economic'),
            left: document.getElementById('val-spiritual')
        };

        const updateShape = () => {
            const vals = {
                top: parseInt(sliders.top.value),
                right: parseInt(sliders.right.value),
                bottom: parseInt(sliders.bottom.value),
                left: parseInt(sliders.left.value)
            };

            displays.top.innerText = vals.top + '%';
            displays.right.innerText = vals.right + '%';
            displays.bottom.innerText = vals.bottom + '%';
            displays.left.innerText = vals.left + '%';

            // Update each arc flawlessly from the center outward
            Object.keys(arcs).forEach(key => {
                const val = vals[key];
                
                // Calculate how much of the quadrant should be filled
                const visibleLength = (val / 100) * QUADRANT_LENGTH;
                
                // To grow from the center, we offset it backwards by exactly half the remaining empty space
                const offset = -((QUADRANT_LENGTH - visibleLength) / 2);
                
                // Apply the dash array (visible length, then total length gap)
                arcs[key].style.strokeDasharray = `${visibleLength} ${QUADRANT_LENGTH}`;
                arcs[key].style.strokeDashoffset = offset;
            });

            // Calculate Brightness and Glow
            const averageScore = (vals.top + vals.right + vals.bottom + vals.left) / 4;
            const opacity = 0.3 + ((averageScore / 100) * 0.7);
            const glowRadius = (averageScore / 100) * 15;

            const filterValue = `drop-shadow(0px 0px ${glowRadius}px rgba(16, 185, 129, ${opacity}))`;
            
            Object.values(arcs).forEach(arc => {
                arc.style.strokeOpacity = opacity;
                arc.style.filter = filterValue;
            });

            core.style.fillOpacity = opacity;
            core.style.filter = filterValue;
        };

        Object.values(sliders).forEach(slider => {
            slider.addEventListener('input', updateShape);
        });

        updateShape();
    });
</script>

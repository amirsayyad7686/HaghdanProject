<%- include('partials/header') %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <!-- Header -->
    <div class="text-center mb-16 animate-fade-in-down">
        <div class="inline-flex items-center justify-center p-3 bg-indigo-100 text-indigo-600 rounded-full mb-6">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
        </div>
        <h1 class="text-4xl sm:text-5xl font-black text-slate-900 tracking-tight mb-4"><%= __('Education & Philosophy') %></h1>
        <p class="text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto font-medium"><%= __('Understanding the Matrix Hub and our Round Table approach through step-by-step video guides.') %></p>
    </div>
    
    <!-- Timeline / Video Steps -->
    <div class="space-y-12">
        
        <!-- STEP 1 -->
        <div class="flex flex-col sm:flex-row gap-6 relative group">
            <!-- Timeline Line (Hidden on very small mobile, shown on sm+) -->
            <div class="hidden sm:flex flex-col items-center">
                <div class="w-12 h-12 bg-indigo-600 text-white rounded-full flex items-center justify-center font-black text-xl shadow-lg z-10 group-hover:scale-110 transition-transform">1</div>
                <div class="w-1 h-full bg-indigo-100 my-2 rounded-full"></div>
            </div>
            
            <div class="flex-1 bg-white p-6 sm:p-8 rounded-[32px] border border-slate-200 shadow-sm hover:shadow-xl transition-shadow">
                <!-- Mobile Step Indicator -->
                <div class="sm:hidden w-10 h-10 bg-indigo-600 text-white rounded-full flex items-center justify-center font-black text-lg mb-4 shadow-md">1</div>
                
                <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3"><%= __('Step 1: The Core Philosophy') %></h2>
                <p class="text-slate-600 leading-relaxed mb-6"><%= __('Step 1 Desc') %></p>
                
                <!-- Video Container -->
                <div class="relative w-full aspect-video bg-slate-900 rounded-2xl overflow-hidden shadow-inner border-4 border-slate-100">
                    <!-- Replace 'src' with your actual video link (e.g., /videos/step1.mp4) -->
                    <!-- Replace 'poster' with a thumbnail image (e.g., /images/poster1.jpg) -->
                    <video controls class="w-full h-full object-cover" poster="/images/video-placeholder-1.jpg">
                        <source src="/videos/step1.mp4" type="video/mp4">
                        <%= __('Your browser does not support the video tag.') %>
                    </video>
                </div>
            </div>
        </div>

        <!-- STEP 2 -->
        <div class="flex flex-col sm:flex-row gap-6 relative group">
            <div class="hidden sm:flex flex-col items-center">
                <div class="w-12 h-12 bg-indigo-600 text-white rounded-full flex items-center justify-center font-black text-xl shadow-lg z-10 group-hover:scale-110 transition-transform">2</div>
                <div class="w-1 h-full bg-indigo-100 my-2 rounded-full"></div>
            </div>
            
            <div class="flex-1 bg-white p-6 sm:p-8 rounded-[32px] border border-slate-200 shadow-sm hover:shadow-xl transition-shadow">
                <div class="sm:hidden w-10 h-10 bg-indigo-600 text-white rounded-full flex items-center justify-center font-black text-lg mb-4 shadow-md">2</div>
                
                <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3"><%= __('Step 2: Discovering Your Role') %></h2>
                <p class="text-slate-600 leading-relaxed mb-6"><%= __('Step 2 Desc') %></p>
                
                <!-- Video Container -->
                <div class="relative w-full aspect-video bg-slate-900 rounded-2xl overflow-hidden shadow-inner border-4 border-slate-100">
                    <video controls class="w-full h-full object-cover" poster="/images/video-placeholder-2.jpg">
                        <source src="/videos/step2.mp4" type="video/mp4">
                        <%= __('Your browser does not support the video tag.') %>
                    </video>
                </div>
            </div>
        </div>

        <!-- STEP 3 -->
        <div class="flex flex-col sm:flex-row gap-6 relative group">
            <div class="hidden sm:flex flex-col items-center">
                <div class="w-12 h-12 bg-indigo-600 text-white rounded-full flex items-center justify-center font-black text-xl shadow-lg z-10 group-hover:scale-110 transition-transform">3</div>
                <div class="w-1 h-0 bg-transparent my-2"></div> <!-- No line after the last step -->
            </div>
            
            <div class="flex-1 bg-white p-6 sm:p-8 rounded-[32px] border border-slate-200 shadow-sm hover:shadow-xl transition-shadow">
                <div class="sm:hidden w-10 h-10 bg-indigo-600 text-white rounded-full flex items-center justify-center font-black text-lg mb-4 shadow-md">3</div>
                
                <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3"><%= __('Step 3: Creating Synergy and Execution') %></h2>
                <p class="text-slate-600 leading-relaxed mb-6"><%= __('Step 3 Desc') %></p>
                
                <!-- Video Container -->
                <div class="relative w-full aspect-video bg-slate-900 rounded-2xl overflow-hidden shadow-inner border-4 border-slate-100">
                    <video controls class="w-full h-full object-cover" poster="/images/video-placeholder-3.jpg">
                        <source src="/videos/step3.mp4" type="video/mp4">
                        <%= __('Your browser does not support the video tag.') %>
                    </video>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    @keyframes fadeInDown {
        0% { opacity: 0; transform: translateY(-20px); }
        100% { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-down { animation: fadeInDown 0.8s ease-out forwards; }
</style>

<%- include('partials/footer') %>
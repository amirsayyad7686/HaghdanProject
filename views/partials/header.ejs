<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= lang === 'fa' ? 'rtl' : 'ltr' %>" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Matrix Hub' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Persian Font overrides for better typography */
        @import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;700;900&display=swap');
        html[dir="rtl"] { font-family: 'Vazirmatn', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased min-h-screen flex flex-col">
    
    <nav class="bg-white/80 backdrop-blur-md border-b border-slate-200 sticky top-0 z-50 transition-all">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                
                <!-- Logo -->
                <div class="flex items-center gap-8">
                    <a href="/" class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-blue-600 tracking-tighter">
                        <%= __('Matrix Hub.') %>
                    </a>
                    
                    <!-- Desktop Menu -->
                    <div class="hidden lg:flex items-center gap-6">
                        <a href="/contributions" class="text-sm font-bold text-slate-600 hover:text-emerald-600 transition-colors"><%= __('Live Assets') %></a>
                        <a href="/projects" class="text-sm font-bold text-slate-600 hover:text-emerald-600 transition-colors"><%= __('Project Pipeline') %></a>
                        <a href="/cooperate" class="text-sm font-bold text-slate-600 hover:text-emerald-600 transition-colors"><%= __('Matrix') %></a>
                        
                        <!-- NEW ROUTES -->
                        <div class="w-px h-5 bg-slate-300 mx-2"></div>
                        <a href="/group-therapy" class="text-sm font-bold text-purple-600 hover:text-purple-700 transition-colors"><%= __('Group Therapy') %></a>
                        <a href="/education" class="text-sm font-bold text-indigo-600 hover:text-indigo-700 transition-colors"><%= __('Education & Philosophy') %></a>
                    </div>
                </div>

                <!-- Right Side Actions -->
                <div class="hidden lg:flex items-center gap-4">
                    <!-- Language Switcher -->
                    <div class="flex items-center bg-slate-100 rounded-lg p-1 border border-slate-200">
                        <a href="/lang/en" class="px-3 py-1 text-xs font-bold rounded-md transition-colors <%= lang === 'en' ? 'bg-white shadow-sm text-slate-900' : 'text-slate-500 hover:text-slate-900' %>">EN</a>
                        <a href="/lang/fa" class="px-3 py-1 text-xs font-bold rounded-md transition-colors <%= lang === 'fa' ? 'bg-white shadow-sm text-slate-900' : 'text-slate-500 hover:text-slate-900' %>">FA</a>
                    </div>

                    <% if (sessionUserId) { %>
                        <a href="/dashboard" class="bg-slate-900 hover:bg-slate-800 text-white text-sm font-bold py-2.5 px-5 rounded-lg shadow-sm transition-all"><%= __('Workspace') %></a>
                    <% } else { %>
                        <a href="/login" class="text-slate-600 hover:text-slate-900 text-sm font-bold py-2 px-4 transition-colors"><%= __('Log In') %></a>
                        <a href="/register" class="bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-bold py-2.5 px-5 rounded-lg shadow-sm transition-all"><%= __('Register') %></a>
                    <% } %>
                </div>

                <!-- Mobile menu button -->
                <div class="lg:hidden flex items-center gap-4">
                    <div class="flex items-center bg-slate-100 rounded-lg p-1 border border-slate-200">
                        <a href="/lang/en" class="px-2 py-1 text-xs font-bold rounded-md <%= lang === 'en' ? 'bg-white shadow-sm text-slate-900' : 'text-slate-500' %>">EN</a>
                        <a href="/lang/fa" class="px-2 py-1 text-xs font-bold rounded-md <%= lang === 'fa' ? 'bg-white shadow-sm text-slate-900' : 'text-slate-500' %>">FA</a>
                    </div>
                    <button id="mobile-menu-btn" class="text-slate-600 hover:text-slate-900 focus:outline-none">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu Panel -->
        <div id="mobile-menu" class="hidden lg:hidden bg-white border-b border-slate-200">
            <div class="px-4 pt-2 pb-6 space-y-1">
                <a href="/contributions" class="block px-3 py-3 text-slate-700 hover:bg-slate-50 hover:text-emerald-600 rounded-md font-bold text-base"><%= __('Live Assets') %></a>
                <a href="/projects" class="block px-3 py-3 text-slate-700 hover:bg-slate-50 hover:text-emerald-600 rounded-md font-bold text-base"><%= __('Project Pipeline') %></a>
                <a href="/cooperate" class="block px-3 py-3 text-slate-700 hover:bg-slate-50 hover:text-emerald-600 rounded-md font-bold text-base"><%= __('Matrix') %></a>
                
                <hr class="my-2 border-slate-100">
                <!-- NEW ROUTES MOBILE -->
                <a href="/group-therapy" class="block px-3 py-3 text-purple-700 bg-purple-50 hover:bg-purple-100 rounded-md font-bold text-base"><%= __('Group Therapy') %></a>
                <a href="/education" class="block px-3 py-3 text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-md font-bold text-base"><%= __('Education & Philosophy') %></a>
                
                <hr class="my-3 border-slate-100">
                
                <% if (sessionUserId) { %>
                    <a href="/dashboard" class="block w-full px-3 py-3 bg-slate-900 text-white rounded-lg font-bold text-center"><%= __('Workspace') %></a>
                    <a href="/logout" class="block w-full px-3 py-3 text-red-600 hover:bg-red-50 rounded-lg font-bold text-center mt-2"><%= __('Terminate') %></a>
                <% } else { %>
                    <a href="/login" class="block w-full px-3 py-3 text-slate-700 border border-slate-300 rounded-lg font-bold text-center"><%= __('Log In') %></a>
                    <a href="/register" class="block w-full px-3 py-3 bg-emerald-600 text-white rounded-lg font-bold text-center mt-2"><%= __('Register') %></a>
                <% } %>
            </div>
        </div>
<div id="mobile-menu" class="hidden lg:hidden bg-white border-b border-slate-200">
            <div class="px-4 pt-2 pb-6 space-y-1">
                </div>
        </div>
    </nav>
    
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const mobileBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            
            if (mobileBtn && mobileMenu) {
                mobileBtn.addEventListener('click', () => {
                    // This toggles the 'hidden' class on and off when tapped!
                    mobileMenu.classList.toggle('hidden');
                });
            }
        });
    </script>
    
    <main class="flex-grow w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">